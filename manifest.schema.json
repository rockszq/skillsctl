{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rockszq/skillsctl/manifest.schema.json",
  "title": "skillsctl manifest",
  "type": "object",
  "required": ["schema", "skills"],
  "properties": {
    "schema": {
      "type": "integer",
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "description": "Written by refresh; do not edit by hand."
    },
    "skills": {
      "type": "object",
      "description": "Skill name -> flavors and per-tool target.",
      "additionalProperties": {
        "type": "object",
        "required": ["flavors", "targets"],
        "properties": {
          "flavors": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["files", "hash"],
              "properties": {
                "files": { "type": "integer", "minimum": 0 },
                "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          },
          "targets": {
            "type": "object",
            "description": "Tool name -> flavor name.",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    },
    "excluded": {
      "type": "array",
      "description": "Known directories that are deliberately not managed.",
      "items": {
        "type": "object",
        "required": ["name", "tool", "reason"],
        "properties": {
          "name": { "type": "string" },
          "tool": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
